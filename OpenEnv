        """Resets the environment to day 0 and returns the first price."""
        self.current_step = 0
        return self.prices[self.current_step]

    def step(self, action):
        """
        Simulates moving to the next day.
        Reward is calculated as the price difference from the previous day.
        """
        self.current_step += 1
        
        # Check if we reached the last day in our dataset
        done = self.current_step >= len(self.prices) - 1
        
        # Calculate reward based on price movement (Profit or Loss)
        reward = self.prices[self.current_step] - self.prices[self.current_step - 1]
        next_state = self.prices[self.current_step]
        
        return next_state, reward, done

