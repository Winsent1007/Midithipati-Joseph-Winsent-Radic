class TaskManagerEnv:
    def _init_(self):
        # The 'real-world' state: a simple JSON database
        self.db_path = "tasks_db.json"
        self._initialize_db()
        self.max_steps = 10
        self.current_step = 0

    def _initialize_db(self):
        with open(self.db_path, "w") as f:
            json.dump({"tasks": []}, f)

    def state(self):
        """Returns the current observation of the 'real world'."""
        with open(self.db_path, "r") as f:
            return json.load(f)

    def reset(self):
        """Resets the environment to a starting state."""
        self._initialize_db()
        self.current_step = 0
        return self.state(), {}

    def step(self, action):
        """
        Executes an action. 
        Action format: {"cmd": "add", "task": "text"} or {"cmd": "done", "id": 0}
        """
        self.current_step += 1
        reward = 0
        data = self.state()
        
        # Real-world logic
        if action["cmd"] == "add":
            data["tasks"].append({"id": len(data["tasks"]), "text": action["task"], "status": "pending"})
            reward = 1  # Reward for creating a task
        elif action["cmd"] == "done":
            idx = action["id"]
            if 0 <= idx < len(data["tasks"]):
                data["tasks"][idx]["status"] = "completed"
                reward = 5  # High reward for completing a task
        
        # Save 'real-world' changes
        with open(self.db_path, "w") as f:
            json.dump(data, f)

        terminated = self.current_step >= self.max_steps
        return self.state(), reward, terminated, False, {}

